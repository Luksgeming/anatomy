# Salin file ini menjadi .env.local lalu isi nilainya.

# API key Anthropic untuk kotak "Ubah rumah" (https://console.anthropic.com → API Keys).
ANTHROPIC_API_KEY=

# Wajib di production: hanya yang tahu token ini yang bisa mengubah rumah (dan memakai kredit API).
# Kosongkan saat development lokal.
HS_EDIT_TOKEN=
